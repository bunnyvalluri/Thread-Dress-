{
  "env": {
    "browser": true,
    "es2022": true
  },
  "globals": {
    "catalog": "readonly",
    "money": "readonly",
    "cart": "writable",
    "loadCart": "readonly",
    "saveCart": "readonly",
    "renderCartUI": "readonly",
    "addItemToCart": "readonly",
    "updateQty": "readonly",
    "removeCartItem": "readonly",
    "clearCart": "readonly",
    "toggleCartDrawer": "readonly",
    "quickAddToCart": "readonly",
    "openProductModal": "readonly",
    "toggleProductModal": "readonly",
    "selectModalSize": "readonly",
    "addCurrentModalToCart": "readonly",
    "closeProductModal": "readonly",
    "toggleMobileMenu": "readonly",
    "filterCategory": "readonly",
    "applySortAndFilter": "readonly",
    "renderCatalog": "readonly",
    "resetFilters": "readonly",
    "showSocialNotification": "readonly",
    "runLiveTicker": "readonly",
    "toggleChat": "readonly",
    "handleChatSubmit": "readonly",
    "initiateCheckout": "readonly",
    "triggerSimulatedOrder": "readonly",
    "toggleOrderModal": "readonly",
    "closeOrderModal": "readonly",
    "activeCategory": "writable",
    "activeModalProduct": "writable",
    "selectedSize": "writable"
